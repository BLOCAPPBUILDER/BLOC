<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- BLOC-Dateien (.bloc, ein BLOC, Trainingsplan oder eine Übung): Antippen im Chat, in Mails oder Dateien öffnet BLOC.
                 Nur content://-Adressen (so reichen Apps Dateien weiter). Die Dateien liest BLOC nur lokal, siehe BlocDateiPlugin. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-bloc" />
                <!-- viele Apps kennen die Endung nicht und melden die Datei als „unbekannt“ -->
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" />
                <data android:pathPattern=".*\\.bloc" />
                <data android:pathPattern=".*\\..*\\.bloc" />
                <data android:pathPattern=".*\\..*\\..*\\.bloc" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.bloc" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-bloc" />
            </intent-filter>
        </activity>

        <!-- Der Standort-Dienst des Plugins ist dort exportiert; BLOC bindet ihn nur aus dem eigenen Prozess, fremde Apps sollen ihn nicht anstoßen können -->
        <service
            android:name="com.equimaps.capacitor_background_geolocation.BackgroundGeolocationService"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:exported" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Vibration bei Timer, Sätzen und Lauf (navigator.vibrate im WebView) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Das Benachrichtigungs-Plugin bringt Alarm- und Neustart-Berechtigungen mit, die BLOC nicht nutzt (es fragt nur die Erlaubnis für Hinweise ab) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
</manifest>
