<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- BLOC-Dateien (.bloc, ein BLOC, Trainingsplan oder eine Übung): Antippen im Chat, in Mails oder Dateien öffnet BLOC.
                 Nur content://-Adressen (so reichen Apps Dateien weiter). Die Dateien liest BLOC nur lokal, siehe BlocDateiPlugin. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-bloc" />
                <!-- viele Apps kennen die Endung nicht und melden die Datei als „unbekannt“ -->
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" />
                <data android:pathPattern=".*\\.bloc" />
                <data android:pathPattern=".*\\..*\\.bloc" />
                <data android:pathPattern=".*\\..*\\..*\\.bloc" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.bloc" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-bloc" />
            </intent-filter>
        </activity>

        <!-- Der Standort-Dienst des Plugins ist dort exportiert; BLOC bindet ihn nur aus dem eigenen Prozess, fremde Apps sollen ihn nicht anstoßen können -->
        <service
            android:name="com.equimaps.capacitor_background_geolocation.BackgroundGeolocationService"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:exported" />

        <!-- Timer im Hintergrund: laufende Anzeige in der Benachrichtigungsleiste, hält die Signaltöne am Laufen (nur aus der App gestartet) -->
        <service
            android:name=".BlocTimerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Health Connect: Erklärung, wofür BLOC die Herzfrequenz liest (bis Android 13 über die Rationale-Aktion, ab Android 14 über den Alias) -->
        <activity
            android:name=".PulsDatenschutzActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".PulsDatenschutzActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Vibration bei Timer, Sätzen und Lauf (navigator.vibrate im WebView) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Timer-Dienst: Vordergrund-Dienst (Signaltöne im Hintergrund) und seine Anzeige in der Benachrichtigungsleiste -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Timer: CPU wach halten, damit die Signaltöne bei ausgeschaltetem Bildschirm pünktlich kommen (nur solange ein Timer läuft) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Das Benachrichtigungs-Plugin bringt Alarm- und Neustart-Berechtigungen mit, die BLOC nicht nutzt (es fragt nur die Erlaubnis für Hinweise ab) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <!-- Puls aus Health Connect: nur lesen, nur für die Zeit eigener Läufe (BlocPulsPlugin) -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
    <!-- Health Connect braucht Android 9; die Bibliothek verlangt minSdk 26, BLOC prüft die Version selbst vor jedem Aufruf -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />
</manifest>
